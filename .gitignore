# ============================================================
#  SECRETS — never commit these
# ============================================================
.env
*.env
!*.env.example
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key
secrets.json
credentials.json

# ============================================================
#  Virtual environments (any name, any location)
# ============================================================
# NOTE: patterns here must be ANCHORED or venv-specific.
# A bare "Lib/" also matches "frontend/src/lib/" because Git on Windows is
# case-insensitive by default (core.ignorecase=true) — that silently drops
# real source files from the repo and breaks the build.
venv/
.venv/
env/
ENV/
pyvenv.cfg
**/site-packages/
# venv internals, only when they sit beside a pyvenv.cfg-style venv folder
venv/Lib/
venv/Scripts/
venv/Include/
.venv/Lib/
.venv/Scripts/
.venv/Include/
# a venv created as `python -m venv hire` at the repo root
/hire/Lib/
/hire/Scripts/
/hire/Include/
/hire/pyvenv.cfg

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
#  Database
# ============================================================
*.db
*.sqlite
*.sqlite3
backend/hire.db

# ============================================================
#  Node / frontend
# ============================================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.eslintcache
npm-debug.log*
yarn-error.log*

# ============================================================
#  Uploads (user content — not source code)
# ============================================================
backend/uploads/*
!backend/uploads/.gitkeep

# ============================================================
#  Editors / OS
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
