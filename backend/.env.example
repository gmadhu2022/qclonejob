# Copy this file to ".env" and edit. Defaults run instantly with zero setup.
# IMPORTANT: each key must appear ONLY ONCE. If a key is repeated, the LAST one wins.

# ============================ DATABASE ============================
# --- Option A: local SQLite (zero setup, default) ---
DATABASE_URL=sqlite:///./hire.db

# --- Option B: Supabase Postgres (recommended once you're past first run) ---
# Full walkthrough: see SUPABASE_SETUP.md in the project root.
#   1) Supabase > Connect > Connection string > URI
#   2) Use the SESSION POOLER string (the direct db.<ref>.supabase.co host is
#      IPv6-only and fails on most Indian home/office networks).
#   3) Change "postgresql://" to "postgresql+psycopg2://"
#   4) Replace [YOUR-PASSWORD] and percent-encode specials: @ = %40, # = %23, / = %2F
#   5) Comment out the SQLite line above — only ONE DATABASE_URL may be active,
#      because the last one in this file wins.
#   6) Verify with:  python check_db.py
#
#   The user MUST be  postgres.<your-project-ref>  — your ref is the ~20-char ID in
#   your dashboard URL: https://supabase.com/dashboard/project/<THIS-IS-YOUR-REF>
#   Copying the example verbatim gives: "tenant/user ... not found".
#
# DATABASE_URL=postgresql+psycopg2://postgres.<YOUR-PROJECT-REF>:<YOUR-PASSWORD>@<YOUR-POOLER-HOST>.pooler.supabase.com:5432/postgres

# ============================== AUTH ==============================
JWT_SECRET=change-me-to-a-long-random-string

# ============================= EMAIL ==============================
# False = emails print to the backend terminal (perfect while developing).
# True  = actually send, using the SMTP settings below.
EMAIL_ENABLED=False

# ---- OPTION A: Brevo — FREE, no domain needed, 300 emails/day ----
# Best zero-budget choice. Recipients get real inbox delivery.
#   1) Sign up: https://www.brevo.com  (free plan)
#   2) Senders & IPs > Senders > Add a sender -> use your own Gmail address.
#      Click the confirmation link Brevo emails you. (No domain required.)
#   3) SMTP & API > SMTP -> copy your login and "SMTP key" (not your Brevo password).
#   4) Fill these in, set EMAIL_ENABLED=True above, restart the backend.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=the-gmail-you-verified@gmail.com

# ---- OPTION B: Mailjet — FREE, no domain needed, 200/day ----
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_USER=your-mailjet-api-key
# SMTP_PASSWORD=your-mailjet-secret-key
# EMAIL_FROM=the-email-you-verified@gmail.com

# ---- OPTION C: Gmail SMTP (only ~500/day; needs an App Password) ----
# App Passwords appear ONLY after 2-Step Verification is fully enabled.
# https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=your16charapppassword
# EMAIL_FROM=youraddress@gmail.com

# ---- LATER: your own domain (admin@yourdomain.in) ----
# Keep the same provider above, add your domain in its dashboard, add the SPF +
# DKIM DNS records it gives you, then set EMAIL_FROM to your domain address.
# No code change needed.

# =============================== AI ===============================
# Free key: https://console.groq.com/keys
AI_ENABLED=False
GROQ_API_KEY=
# Model IDs change over time and vary by account.
# To see exactly what YOUR key supports, start the backend, log in as admin and open:
#   http://localhost:8000/api/ai/models
# (or run the curl command in the README). Then paste a valid ID below.
GROQ_MODEL=openai/gpt-oss-20b

# =============================== APP ==============================
FRONTEND_URL=http://localhost:5173
