# Copy to backend/.env and fill in. .env is gitignored — config.py is NOT.
# Every value below used to be hardcoded in config.py. Move them here.

# --- Database ---
DATABASE_URL=sqlite:///./hire.db

# --- Auth ---
JWT_SECRET=generate-a-long-random-string-for-production

# --- Email (Brevo transactional: 300/day free, forever, no card) ---
# Key:    Brevo -> SMTP & API -> API Keys -> Generate a new API key (v3)
# Sender: Brevo -> Senders, Domains & Dedicated IPs -> Senders -> add + verify
# Until the sender address is verified Brevo refuses the send with a 400.
EMAIL_ENABLED=true
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_NAME=QCloneJob
BREVO_SENDER_EMAIL=you@yourverifieddomain.com
EMAIL_FROM=you@yourverifieddomain.com

# --- Email (Resend alternative: set EMAIL_PROVIDER=resend) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- Email (SMTP fallback: set EMAIL_PROVIDER=smtp to use this instead) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password

# --- SMS / OTP (SMS8.io) ---
# console = codes print to the server terminal, which is fine for development.
SMS_PROVIDER=console
# SMS_PROVIDER=sms8
# SMS8_API_KEY=xxxxxxxx
# SMS8_DEVICE_ID=            # only for Android-gateway mode
# SMS8_SENDER_ID=

OTP_REQUIRED=false

# --- AI (Groq) ---
AI_ENABLED=false
# GROQ_API_KEY=gsk_xxxxxxxx

# --- App ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Institute portal
# ---------------------------------------------------------------------------
# Institutes choose their own password at registration and can log in straight
# away. Set to false to hold them at "pending" until an admin approves.
INSTITUTE_SELF_APPROVE=true

# Email OTPs do not expire. SMS OTPs still expire after 10 minutes.
EMAIL_OTP_NEVER_EXPIRES=true

# DEV ONLY — with no mail provider configured, return the OTP in the API
# response so registration can be tested locally. NEVER enable in production.
OTP_DEV_ECHO=false

# Post a Ad — flyer artwork is cover-cropped to this size (the mobile ad slot),
# and scroller text is capped at this many characters.
AD_FLYER_WIDTH=1080
AD_FLYER_HEIGHT=360
AD_SCROLLER_MAX_CHARS=120
