{
  "root": true,
  "env": { "browser": true, "es2022": true },
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "plugins": ["react"],
  "settings": { "react": { "version": "18" } },
  "rules": {
    "no-undef": "error",
    "react/jsx-no-undef": "error",
    "no-dupe-keys": "error",
    "no-unreachable": "error"
  }
}
